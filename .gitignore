# ==== JobFlow AI — archivos que NO deben compartirse ====
# Dependencias locales
.venv/
__pycache__/
*.pyc
*.pyo

# Datos sensibles (CVs subidos, base de datos con datos personales de candidatos)
data/*.db
data/*.db-journal
data/uploads/
data/*.pdf
data/*.docx
# Sesiones cifradas de portales, su clave y capturas de postulaciones
data/.jobflow_key
data/evidencias/

# Credenciales / configuración local (contiene API keys y SMTP)
.env
.env.local

# Sistema / editores
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.log

pip_install.log

.pytest_cache/
*.db-wal
*.db-shm
*.bundle
*.zip
