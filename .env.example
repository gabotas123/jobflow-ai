# ===== JobFlow AI - variables de entorno =====
# Copia este archivo a `.env` y completa si vas a usar LLM.

# Proveedor de LLM: deepseek | openai | ollama | none
#   "none" => motor deterministico (la app funciona sin API key)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Base de datos (SQLite por defecto; PostgreSQL en produccion)
DATABASE_URL=sqlite:///data/jobflow.db

# Puerta de la app web
PORT=8000

# Confirmacion humana antes de enviar (recomendado: true)
JOBFLOW_CONFIRM=true
